# Copy to .env (never commit .env). All values are optional.

# Public production URL, e.g. https://example.com — used for canonical tags,
# Open Graph URLs and sitemap.xml. On Vercel this falls back automatically to
# VERCEL_PROJECT_PRODUCTION_URL, so you only need it for a custom domain.
VITE_SITE_URL=

# Contact form delivery.
# Option A (recommended): a Web3Forms access key from https://web3forms.com
# (Web3Forms keys are designed to be used in public client-side code).
VITE_WEB3FORMS_ACCESS_KEY=

# Option B (default when no Web3Forms key is set): FormSubmit (https://formsubmit.co).
# The first submission triggers a one-time activation email. After activation,
# FormSubmit gives you a random alias — put it here to hide the email address.
VITE_FORMSUBMIT_ID=
