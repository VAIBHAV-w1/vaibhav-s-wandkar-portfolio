# Copy to .env (never commit .env).

# Optional canonical production URL (Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically).
VITE_SITE_URL=

# Server-side SMTP configuration for /api/contact (NEVER prefix with VITE_).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
